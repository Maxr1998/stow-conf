pkgname=maxr1998-config
pkgver=1.5.0
pkgrel=1
pkgdesc="Maxr1998's system scripts and config"
arch=("any")
url="https://github.com/Maxr1998/stow-conf"
license=('WTFPL')
depends=("bash" "usbutils")
source=("create_backup"
        "login.sh"
        "usbreset"
        "zfs-mount-home")
b2sums=('a6c5be5b400854853d389661c1ad94c5aec03acd9227dd9ed678f2fc94115e421818c4ea9a00e9fa25754cdf1ece855c82ec09cae13b100febee66c0a5fae3d5'
        '6b46d7a4cffc41f512d87c7a4ef340e8754a885051ad3ad28ea2f212785f9969416bb54d6efdacf908053424f2472aa78484f29b2d3cedbdc0571826f8f53bed'
        'cd7aaca4520bcc433ccc13ad44557a1355cb928d59abd459d9f6819f4e89dbd9670df4afab9c14f64ef2fe391f31fa9780d8ac4996d99016d8f6a231cd382006'
        'cea8f6cdf2082a657c8149919d0fba7442d035848ae16a4d69ec534e86c19d97a2ec0132bb9cf8321d13819db6a42743ce03cf821484da944b5ff56e9df33502')

package() {
    cd "$srcdir"
    mkdir -p "$pkgdir/etc/ly/"
    mkdir -p "$pkgdir/usr/bin/"
    mkdir -p "$pkgdir/usr/lib/systemd/system/"
    cp -f "login.sh" "$pkgdir/etc/ly/"
    cp -f "zfs-mount-home" "$pkgdir/usr/bin/"
    cp -f "create_backup" "$pkgdir/usr/bin/"
    install -Dm0644 -t "$pkgdir/etc/sudoers.d/" usbreset
}
